---
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  /** Prefix for links back to the home page: '' on the home page, 'index.html' on other pages, '/' on the 404 page (served at any path). */
  home?: string;
  /** Keep this page out of search engines (private pages such as onboarding). */
  noindex?: boolean;
}

const { title, description, home = '', noindex = false } = Astro.props;
const shareImage = site.url ? `${site.url}/og.png` : null;
// Icons sit at the site root: relative on normal pages, absolute on the 404 page.
const root = home.startsWith('/') ? '/' : '';
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${root}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${root}apple-touch-icon.png`} />
    <meta name="theme-color" content="#1d4a35" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {site.url && <meta property="og:url" content={`${site.url}/`} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content={`${site.name}: ${site.role}, ${site.city}`} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Figtree:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="masthead">
        <a class="wordmark" href={`${home}#top`}>
          <span class="name">{site.name}</span>
          <span class="role">{site.role} · {site.city}</span>
        </a>
        <nav aria-label="Main">
          <a href={`${home}#work`}>Work</a>
          <a href={`${home}#pricing`}>Pricing</a>
          <a href={`${home}#how`}>How it works</a>
          <a href={`${home}#faq`}>FAQ</a>
          <a class="nav-cta" href={`${home}#contact`}>Get in touch</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <p>© {new Date().getFullYear()} {site.name} · {site.city}, {site.country}</p>
        <p>Built with the same setup I use for clients.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f3f1ec;
    --panel: #fbfaf7;
    --ink: #13231b;
    --soft: #56625a;
    --green: #1d4a35;
    --on-green: #f3f1ec;
    --gold: #c9962b;
    /* Darker gold for text, so it's readable on the light background. */
    --gold-text: #a87a1a;
    --rule: #d6d9cf;
    --error: #a3261e;
    --display: 'Alfa Slab One', 'Rockwell', 'Roboto Slab', Georgia, serif;
    --body: 'Figtree', 'Segoe UI', system-ui, sans-serif;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #0f1a14;
      --panel: #16241c;
      --ink: #eef2ea;
      --soft: #a7b3aa;
      --green: #7fbf97;
      --on-green: #0f1a14;
      --gold: #e0b453;
      --gold-text: #e0b453;
      --rule: #26352c;
      --error: #ff8f86;
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --paper: #0f1a14;
    --panel: #16241c;
    --ink: #eef2ea;
    --soft: #a7b3aa;
    --green: #7fbf97;
    --on-green: #0f1a14;
    --gold: #e0b453;
    --gold-text: #e0b453;
    --rule: #26352c;
    --error: #ff8f86;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    padding-block: 0 2rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    border-radius: 3px;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--green);
    color: var(--on-green);
    border: 2px solid var(--green);
    border-radius: 0.4rem;
    padding: 0.8rem 1.4rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--panel);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.4rem;
    border-bottom: 2px solid var(--ink);
  }

  .wordmark {
    display: grid;
    text-decoration: none;
    line-height: 1.1;
  }

  .wordmark .name {
    font-family: var(--display);
    font-size: 1.5rem;
  }

  .wordmark .role {
    font-size: 0.85rem;
    color: var(--soft);
  }

  .masthead nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.3rem;
  }

  .masthead nav a {
    text-decoration: none;
    font-weight: 500;
  }

  .masthead nav a:hover {
    color: var(--green);
  }

  .nav-cta {
    border: 2px solid var(--ink);
    border-radius: 0.4rem;
    padding: 0.35rem 0.8rem;
  }

  .footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    color: var(--soft);
    font-size: 0.92rem;
  }

  .footer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      transition: none !important;
    }
  }
</style>
