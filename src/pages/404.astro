---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={`Page not found · ${site.name}`} description="This page doesn't exist." home="/">
  <section class="missing">
    <p class="eyebrow">404</p>
    <h1>That page isn’t here.</h1>
    <p>The link may be old or mistyped. Everything on this site lives on the home page.</p>
    <a class="button" href="/">Back to the home page</a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    padding-block: clamp(3rem, 12vw, 8rem);
    max-width: 40rem;
  }
  .eyebrow {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--green);
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
  }
  p {
    margin: 0;
    color: var(--soft);
    font-size: 1.15rem;
  }
</style>
