---
// Private page for new clients, sent as a link once a job is agreed. Not in
// the menu and kept out of search engines.
import Base from '../layouts/Base.astro';
import OnboardingForm from '../components/OnboardingForm.svelte';
---

<Base title="Your website details · Cameron Belcher" description="Details for your new website." home="index.html" noindex>
  <section class="onboarding">
    <p class="eyebrow">Getting started</p>
    <h1>Tell me about your business</h1>
    <p class="intro">
      Your answers become your website. It takes about 10 minutes, in five short steps. Everything here can be changed
      later.
    </p>
    <div class="form-card">
      <OnboardingForm client:load />
    </div>
  </section>
</Base>

<style>
  .onboarding {
    max-width: 46rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .eyebrow {
    margin: 0;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin-block: 0.6rem 1rem;
  }
  .intro {
    margin: 0 0 2rem;
    color: var(--soft);
    font-size: 1.1rem;
  }
  .form-card {
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 0.8rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }
</style>
