---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.svelte';
import { site } from '../site.config';
import { projects } from '../data/work';

const money = (n: number) => `$${n.toLocaleString('en-NZ')}`;

const benefits = [
  {
    title: 'Fast on phones',
    text: 'Most of your customers look you up on their phone. Your site loads in a blink, even on patchy mobile data.',
  },
  {
    title: 'Found locally',
    text: 'Set up for local search and your Google Business Profile, so people nearby find you when they search.',
  },
  {
    title: 'Easy to update',
    text: 'Send me a quick message for changes, or add a simple editor and post your own news.',
  },
  {
    title: 'No monthly fees',
    text: 'Pay once for your site. After that you only pay when you ask for a change.',
  },
];

// A real sequence, so it's numbered.
const steps = [
  { title: 'A quick chat', text: 'A free 20-minute call about your business and what you want the site to do.' },
  { title: 'Design and build', text: 'I design and build your site, and you see a working preview to give feedback on.' },
  { title: 'Launch', text: 'Once you’re happy, it goes live on your domain, with your Google profile connected.' },
  { title: 'Changes when you need them', text: 'Send me a request whenever something changes. I tell you the price, then do it.' },
];

const faqs = [
  {
    q: 'Do I own my website?',
    a: 'Yes. Your domain, words and photos are yours. If you ever leave, you get a full copy of your site.',
  },
  {
    q: 'Can I change things myself?',
    a: 'Yes, if you add the news editor, you can post news and specials yourself. For anything else, just send me a message and I’ll do it.',
  },
  {
    q: 'Why not Wix, Squarespace or WordPress?',
    a: 'They’re fine for some people, but they take your time to set up and maintain, and often end up slow. My sites are custom and fast, and I make the changes for you when you need them.',
  },
  {
    q: 'Are there any ongoing costs?',
    a: 'Only your domain name, usually around $30 a year, paid straight to the registrar. Hosting is free and set up in your name, and there’s no monthly fee to me.',
  },
  {
    q: 'How do changes work?',
    a: 'Send me what you’d like changed. Small changes are a fixed price; anything bigger gets a quote before I start, so there are no surprises.',
  },
];
---

<Base title={`${site.name} · ${site.role}`} description={site.description}>
  <section class="hero" id="top">
    <div class="hero-text">
      <p class="eyebrow">{site.role} · {site.city}</p>
      <h1>Websites that bring <span class="gold">local customers</span> through the door.</h1>
      <p class="lede">
        I design and build fast, good-looking websites for small businesses around {site.city}.
        No monthly fees: pay once for the build, then only for the changes you ask for.
      </p>
      <div class="actions">
        <a class="button" href="#contact">Get in touch</a>
        <a class="button ghost" href="#pricing">See pricing</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <figure class="browser back"><span class="dots"></span><img src={projects[3].image} alt="" width="1280" height="800" /></figure>
      <figure class="browser front"><span class="dots"></span><img src={projects[0].image} alt="" width="1280" height="800" /></figure>
      <p class="sign">Designed &amp; built<br />in {site.city}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="benefits-title">
    <h2 id="benefits-title" class="visually-hidden">What you get</h2>
    <ul class="benefits">
      {benefits.map((b) => (
        <li>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="work">
    <div class="section-head">
      <p class="eyebrow">Work</p>
      <h2>Recent projects</h2>
      <p class="intro">
        Demo projects showing the kind of sites I build. Each one uses the same fast, low-maintenance
        setup as every client site.
      </p>
    </div>
    <ul class="work">
      {projects.map((p) => (
        <li class="project">
          <figure class="browser">
            <span class="dots"></span>
            <img src={p.image} alt={p.alt} width="1280" height="800" loading="lazy" />
          </figure>
          <p class="kind">{p.kind} <span class="tag">Demo</span></p>
          <h3>{p.title}</h3>
          <p>{p.shows}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="pricing">
    <div class="section-head">
      <p class="eyebrow">Pricing</p>
      <h2>Start small. Add as you grow.</h2>
      <p class="intro">One simple site to start, with extras you can add now or later. After launch, you only pay for the changes you ask for. Prices in {site.currency}.</p>
      <p class="intro">Money tight right now? Get in touch anyway. We can split the cost into smaller payments or start with the basics and add to it later.</p>
    </div>
    <div class="pricing-grid">
      <div class="plan featured">
        <p class="badge">Start here</p>
        <h3>{site.base.name}</h3>
        <p class="summary">{site.base.summary}</p>
        <p class="price">
          <span class="amount">{money(site.base.price)}</span><span class="per">one-off</span>
        </p>
        <ul class="features">
          {site.base.features.map((f) => <li>{f}</li>)}
        </ul>
        <a class="button" href="#contact">Get started</a>
      </div>
      <div class="price-list">
        <h3>Add what you need</h3>
        <p class="note">Now or later, one-off prices.</p>
        <ul>
          {site.addons.map((a) => (
            <li>
              <p class="item-name">{a.name}</p>
              <p class="item-detail">{a.detail}</p>
              <p class="item-price">{money(a.price)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="price-list">
      <h3>After launch: pay per request</h3>
      <ul>
        {site.changes.map((c) => (
          <li>
            <p class="item-name">{c.name}</p>
            <p class="item-detail">{c.detail}</p>
            <p class="item-price">{c.price === null ? 'Quoted' : money(c.price)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="how">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>From first chat to live site</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="faq">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2>Questions people ask</h2>
    </div>
    <div class="faqs">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section contact" id="contact">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Let’s talk about your website</h2>
      <p class="intro">
        Tell me a little about your business and I’ll get back to you to set up a free, no-pressure
        chat.
      </p>
      {site.email && <p class="email">Or email <a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
    <div class="form-card">
      <ContactForm client:visible />
    </div>
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .eyebrow {
    margin: 0;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2.5rem 3.5rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    margin-block: 0.9rem 1.3rem;
  }

  .gold {
    color: var(--gold);
  }

  .lede {
    max-width: 44ch;
    font-size: 1.18rem;
    color: var(--soft);
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .browser {
    margin: 0;
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 0.6rem;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
  }

  .dots {
    display: block;
    height: 1.4rem;
    border-bottom: 2px solid var(--ink);
    background:
      radial-gradient(circle at 0.8rem 50%, var(--gold) 0.28rem, transparent 0.3rem),
      radial-gradient(circle at 1.7rem 50%, var(--rule) 0.28rem, transparent 0.3rem),
      radial-gradient(circle at 2.6rem 50%, var(--rule) 0.28rem, transparent 0.3rem);
  }

  .browser img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-art {
    position: relative;
    aspect-ratio: 1 / 0.85;
    max-width: 100%;
  }

  .hero-art .browser {
    position: absolute;
    width: 82%;
  }

  .hero-art .back {
    right: 0;
    top: 0;
    transform: rotate(3deg);
  }

  .hero-art .front {
    left: 0;
    bottom: 6%;
    transform: rotate(-2deg);
  }

  .sign {
    position: absolute;
    right: 2%;
    bottom: 0;
    margin: 0;
    background: var(--green);
    color: var(--on-green);
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.2;
    text-align: center;
    padding: 0.7rem 1rem;
    border-radius: 0.3rem;
    outline: 2px solid var(--gold);
    outline-offset: -6px;
    transform: rotate(-3deg);
  }

  .section {
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: 2.25rem;
  }

  .section-head h2,
  .contact h2 {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    margin-top: 0.5rem;
  }

  .intro {
    color: var(--soft);
    margin: 0.9rem 0 0;
    max-width: 56ch;
  }

  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem 2rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.75rem;
  }

  .benefits h3 {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
  }

  .benefits p {
    margin: 0;
    color: var(--soft);
  }

  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 3rem 2.5rem;
  }

  .project .browser {
    margin-bottom: 1.2rem;
  }

  .kind {
    margin: 0 0 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--green);
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: 0.3rem;
    padding: 0 0.4rem;
  }

  .project h3 {
    font-size: 1.6rem;
    margin-bottom: 0.35rem;
  }

  .project p:last-child {
    margin: 0;
    color: var(--soft);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .plan {
    position: relative;
    display: grid;
    gap: 0.6rem;
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 0.6rem;
    padding: 1.75rem;
  }

  .plan.featured {
    border-color: var(--green);
    box-shadow: 6px 6px 0 var(--gold);
  }

  .badge {
    position: absolute;
    top: -0.8rem;
    left: 1.5rem;
    margin: 0;
    background: var(--gold);
    color: #13231b;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.1rem 0.6rem;
    border-radius: 0.3rem;
  }

  .plan h3 {
    font-size: 1.7rem;
  }

  .summary {
    margin: 0;
    color: var(--soft);
  }

  .price {
    margin: 0.4rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .amount {
    font-family: var(--display);
    font-size: 2.6rem;
    line-height: 1;
  }

  .per {
    color: var(--soft);
    font-weight: 600;
  }

  .price-list {
    margin-top: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: 0.6rem;
    background: var(--panel);
    padding: 1.5rem 1.75rem;
  }

  .pricing-grid .price-list {
    margin-top: 0;
  }

  .note {
    margin: -0.5rem 0 0.75rem;
    color: var(--soft);
  }

  .price-list h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .price-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .price-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 1rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--rule);
  }

  .price-list li p {
    margin: 0;
  }

  .item-name {
    font-weight: 700;
  }

  .item-detail {
    grid-column: 1;
    color: var(--soft);
  }

  .item-price {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-family: var(--display);
    font-size: 1.5rem;
  }

  .features {
    margin: 0.5rem 0 0.75rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .features li {
    padding-left: 1.5rem;
    position: relative;
  }

  .features li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2.5px solid var(--green);
    border-bottom: 2.5px solid var(--green);
    transform: rotate(-45deg);
  }

  .plan .button {
    margin-top: auto;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--green);
    color: var(--on-green);
    font-family: var(--display);
    font-size: 1.3rem;
    margin-bottom: 0.9rem;
  }

  .steps h3 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .steps p {
    margin: 0;
    color: var(--soft);
  }

  .faqs {
    max-width: 48rem;
    border-top: 2px solid var(--ink);
  }

  details {
    border-bottom: 1.5px solid var(--rule);
    padding-block: 1rem;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1.12rem;
    list-style-position: outside;
  }

  details p {
    margin: 0.6rem 0 0;
    color: var(--soft);
    max-width: 60ch;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem 3.5rem;
    align-items: start;
  }

  .email {
    margin: 1rem 0 0;
    font-weight: 600;
  }

  .form-card {
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: 6px 6px 0 var(--green);
  }

  @media (max-width: 52rem) {
    .hero,
    .contact {
      grid-template-columns: 1fr;
    }

    .hero-art {
      width: min(30rem, 100%);
      margin-inline: auto;
    }
  }
</style>
