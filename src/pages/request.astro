---
// Private page for existing clients to ask for changes. Linked from their
// emails, not the menu, and kept out of search engines.
import Base from '../layouts/Base.astro';
import RequestForm from '../components/RequestForm.svelte';
import { site } from '../site.config';
---

<Base title="Ask for a change · Cameron Belcher" description="Ask for a change to your website." home="index.html" noindex>
  <section class="request">
    <p class="eyebrow">For clients</p>
    <h1>Ask for a change</h1>
    <p class="intro">
      Add as many changes as you like. You’ll confirm the request from your email, and I’ll send
      you the price before any work starts. Small changes are ${site.changes[0].price}.
    </p>
    <div class="form-card">
      <RequestForm client:load />
    </div>
  </section>
</Base>

<style>
  .request {
    max-width: 46rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .eyebrow {
    margin: 0;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin-block: 0.6rem 1rem;
  }
  .intro {
    margin: 0 0 2rem;
    color: var(--soft);
    font-size: 1.1rem;
  }
  .form-card {
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 0.8rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }
</style>
